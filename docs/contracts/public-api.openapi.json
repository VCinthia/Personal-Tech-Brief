  "components": {
    "schemas": {
      "BriefHistoryResponse": {
        "required": [
          "briefs",
          "nextCursor"
        ],
        "type": "object",
        "properties": {
          "briefs": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BriefSummaryResponse"
            }
          },
          "nextCursor": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "BriefItemResponse": {
        "required": [
          "id",
          "technologyUpdateId",
          "rank",
          "title",
          "topic",
          "summary",
          "whyRelevant",
          "relevanceScore",
          "generatedAtUtc",
          "promptVersion",
          "modelOrAlgorithmVersion",
          "sources",
          "currentFeedback",
          "isSaved"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "technologyUpdateId": {
            "type": "string",
            "format": "uuid"
          },
          "rank": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "title": {
            "type": "string"
          },
          "topic": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "whyRelevant": {
            "type": "string"
          },
          "relevanceScore": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d\u002B)?(?:[eE][\u002B-]?\\d\u002B)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "generatedAtUtc": {
            "type": "string",
            "format": "date-time"
          },
          "promptVersion": {
            "type": "string"
          },
          "modelOrAlgorithmVersion": {
            "type": "string"
          },
          "sources": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BriefItemSourceResponse"
            }
          },
          "currentFeedback": {
            "type": [
              "null",
              "string"
            ]
          },
          "isSaved": {
            "type": "boolean"
          }
        }
      },
      "BriefItemSourceResponse": {
        "required": [
          "sourceItemId",
          "title",
          "url",
          "publishedAtUtc"
        ],
        "type": "object",
        "properties": {
          "sourceItemId": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string"
          },
          "url": {
            "type": [
              "null",
              "string"
            ]
          },
          "publishedAtUtc": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          }
        }
      },
      "BriefResponse": {
        "required": [
          "brief",
          "items"
        ],
        "type": "object",
        "properties": {
          "brief": {
            "$ref": "#/components/schemas/BriefSummaryResponse"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BriefItemResponse"
            }
          }
        }
      },
      "BriefStatus": {
        "enum": [
          "generating",
          "completed",
          "failed"
        ]
      },
      "BriefSummaryResponse": {
        "required": [
          "id",
          "generatedAtUtc",
          "windowStartUtc",
          "windowEndUtc",
          "status",
          "candidateCount",
          "selectedCount",
          "generationVersion",
          "correlationId"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "generatedAtUtc": {
            "type": "string",
            "format": "date-time"
          },
          "windowStartUtc": {
            "type": "string",
            "format": "date-time"
          },
          "windowEndUtc": {
            "type": "string",
            "format": "date-time"

# Copy to .env for local Docker Compose use. Do not commit .env.
# Replace this with a strong local-only SQL Server SA password. It MUST meet SQL
# Server's policy: at least 8 characters with three of uppercase, lowercase,
# digit and symbol, or SQL Server exits on startup and the app never comes up.
MSSQL_SA_PASSWORD=Change-me-L0cally!

# Set to Y only after reviewing and accepting the local SQL Server and
# Azure Service Bus emulator license terms.
ACCEPT_EULA=N
EMULATOR_HTTP_PORT=5300
SQL_WAIT_INTERVAL=15

# Host port the web UI is published on. Open http://localhost:${WEB_PORT}.
WEB_PORT=8080

{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "FeedValidation": {
    "TimeoutSeconds": 15,
    "MaximumResponseBytes": 1048576,
    "UserAgent": "PersonalTechBrief/1.0"
  },
  "IntelligenceApi": {
    "BaseAddress": "http://localhost:8001/",
    "AnalyzeTimeoutSeconds": 30,
    "SimilarityTimeoutSeconds": 15,
    "GenerateTimeoutSeconds": 60,
    "MaxRetries": 3,
    "RetryBaseDelayMilliseconds": 200
  },
  "BriefGeneration": {
    "WindowLookbackDays": 7,
    "MaxItems": 5,
    "MaxGenerationAttempts": 3,
    "RetryBaseDelayMilliseconds": 200,
    "GenerationVersion": "brief-1"
  },
  "Relevance": {
    "Scoring": {
      "SelectionThreshold": 55
    }
  },
  "AllowedHosts": "*"
}

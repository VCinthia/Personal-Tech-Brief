<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.9" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.9" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.12" />
    <PackageReference Include="SSH.NET" Version="2026.0.0" />
    <PackageReference Include="Testcontainers.MsSql" Version="4.14.0" />
    <PackageReference Include="Testcontainers.ServiceBus" Version="4.14.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\..\docs\contracts\public-api.openapi.json" Link="contracts\public-api.openapi.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Ingestion\Fixtures\**\*.xml" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\..\docs\contracts\intelligence\*.json" Link="Contracts\Fixtures\Intelligence\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\..\infra\servicebus-emulator\config.json" Link="Messaging\Fixtures\servicebus-config.json" CopyToOutputDirectory="PreserveNewest" />
    <ProjectReference Include="..\PersonalTechBrief.Application\PersonalTechBrief.Application.csproj" />
    <ProjectReference Include="..\PersonalTechBrief.Domain\PersonalTechBrief.Domain.csproj" />
    <ProjectReference Include="..\PersonalTechBrief.Ingestion\PersonalTechBrief.Ingestion.csproj" />
    <ProjectReference Include="..\PersonalTechBrief.Infrastructure\PersonalTechBrief.Infrastructure.csproj" />
    <ProjectReference Include="..\PersonalTechBrief.Processor\PersonalTechBrief.Processor.csproj" />
    <ProjectReference Include="..\PersonalTechBrief.Web\PersonalTechBrief.Web.csproj" />
  </ItemGroup>

</Project>
